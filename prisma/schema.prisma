generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AcademicYear {
  id       Int       @id @default(autoincrement())
  label    String    @unique
  isActive Boolean   @default(true)
  classes  Class[]
  students Student[]
}

model Admin {
  id           String    @id
  username     String
  img          String?
  lastActiveAt DateTime?
}

model Teacher {
  id                String    @id
  userId            String    @unique
  username          String    @unique
  name              String
  surname           String
  email             String?   @unique
  phone             String?   @unique
  address           String
  img               String?
  bloodType         String
  sex               UserSex
  createdAt         DateTime  @default(now())
  birthday          DateTime?
  supervisedClasses Class[]   @relation("ClassSupervisor")
  lessons           Lesson[]
  subjects          Subject[] @relation("TeacherSubjects")
}

model Grade {
  id      Int     @id @default(autoincrement())
  level   Int     @unique
  classes Class[]
}

model Class {
  id             Int            @id @default(autoincrement())
  name           String
  capacity       Int
  supervisorId   String
  gradeId        Int?
  academicYearId Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  announcements  Announcement[]
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  grade          Grade?         @relation(fields: [gradeId], references: [id])
  supervisor     Teacher        @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  events         Event[]
  feeStructures  FeeStructure[]
  lessons        Lesson[]
  students       Student[]

  @@unique([name, academicYearId])
}

model Student {
  id             String       @id @default(cuid())
  name           String
  surname        String
  email          String?
  phone          String?      @unique
  address        String
  img            String?
  bloodType      String
  sex            UserSex
  createdAt      DateTime     @default(now())
  parentId       String
  classId        Int
  birthday       DateTime?
  academicYearId Int
  attendances    Attendance[]
  results        Result[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  parent         Parent       @relation(fields: [parentId], references: [id])
  studentFees    StudentFee[]
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  img       String?
  password  String
  students  Student[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  lessons  Lesson[]
  teachers Teacher[] @relation("TeacherSubjects")
}

model Lesson {
  id          Int          @id @default(autoincrement())
  day         Day
  startTime   DateTime
  endTime     DateTime
  subjectId   Int
  classId     Int
  teacherId   String
  name        String
  assignments Assignment[]
  exams       Exam[]
  class       Class        @relation(fields: [classId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([classId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date DateTime @db.Date
  studentId String
  status    String
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model AttendanceControl {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  isOpen    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  results   Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  exam         Exam?       @relation(fields: [examId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  category    String?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id             Int                @id @default(autoincrement())
  title          String
  date           DateTime
  classId        Int?
  createdAt      DateTime           @default(now())
  description    String?
  updatedAt      DateTime           @default(now()) @updatedAt
  whatsappSent   Boolean            @default(false)
  whatsappSentAt DateTime?
  class          Class?             @relation(fields: [classId], references: [id])
  reads          AnnouncementRead[]

  @@index([date])
  @@index([classId])
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  userId         String
  announcementId Int
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  @@index([senderId])
  @@index([receiverId])
}

model FeeStructure {
  id          Int          @id @default(autoincrement())
  classId     Int?
  title       String
  amount      Int
  createdAt   DateTime     @default(now())
  isActive    Boolean      @default(true)
  term        TermType?
  type        FeeType      @default(ADMISSION)
  updatedAt   DateTime     @updatedAt
  class       Class?       @relation(fields: [classId], references: [id])
  studentFees StudentFee[]

  @@index([classId])
  @@index([type])
  @@index([term])
}

model StudentFee {
  id             Int          @id @default(autoincrement())
  studentId      String
  feeStructureId Int
  assignedAt     DateTime     @default(now())
  dueDate        DateTime?
  paidAmount     Int          @default(0)
  status         FeeStatus    @default(PENDING)
  totalAmount    Int
  receiptNo      String?      @unique
  verifyHash     String?      @unique
  payments       Payment[]
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
}

model Payment {
  id           Int         @id @default(autoincrement())
  amount       Int
  studentFeeId Int
  paidAt       DateTime    @default(now())
  referenceId  String?
  mode         PaymentMode @default(CASH)
  studentFee   StudentFee  @relation(fields: [studentFeeId], references: [id])

  @@index([studentFeeId])
  @@index([paidAt])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  isFullDay Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum FeeType {
  ADMISSION
  TERM
  ANNUAL
  MISC
}

enum TermType {
  TERM_1
  TERM_2
  TERM_3
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}
